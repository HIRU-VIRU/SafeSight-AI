# SafeSight AI - Environment Configuration
# Copy this file to .env and customize as needed

# Model Configuration
MODEL_PATH=model/best.pt
CONF_THRESHOLD=0.3
IMG_SIZE=512
DEVICE=0

# Violation Detection
IOU_THRESHOLD=0.3

# Logging & Tracking
DUPLICATE_COOLDOWN_SECONDS=10
TRACKER_MAX_DISAPPEARED=30

# Storage
DATABASE_PATH=safesight.db
STORAGE_PATH=storage/violations

# Camera
CAMERA_ID=camera_01

# API Server
API_HOST=0.0.0.0
API_PORT=5000
API_DEBUG=false

# Alerts
ENABLE_SOUND_ALERT=false
# ALERT_WEBHOOK_URL=https://your-webhook-url.com/alerts

# Performance
TARGET_FPS=20
