# =============================================================================
# SafeSight AI – Environment Variables
# Copy this file to .env and fill in your values.
# On Render, set these in the dashboard (render.yaml handles defaults).
# =============================================================================

# ── Paths ─────────────────────────────────────────────────────────────────────
# Defaults work for local dev.  On Render, override with /data/* paths.
MODEL_PATH=model/best.pt
DATABASE_PATH=safesight.db
STORAGE_PATH=storage/violations
DEMO_STORAGE_PATH=storage/demo
LOG_PATH=logs

# ── Model download (Render / CI) ──────────────────────────────────────────────
# If best.pt is NOT committed to git, set this to a direct download URL.
# build.sh will fetch it automatically.
# Examples:
#   Hugging Face : https://huggingface.co/user/repo/resolve/main/best.pt
#   GitHub Release: https://github.com/user/repo/releases/download/v1/best.pt
MODEL_DOWNLOAD_URL=

# ── YOLO / Detection ──────────────────────────────────────────────────────────
CONF_THRESHOLD=0.30
IOU_THRESHOLD=0.30
IMG_SIZE=512
# Use "cpu" on Render (no GPU). Use "0" locally if you have a GPU.
DEVICE=cpu

# ── Tracking ──────────────────────────────────────────────────────────────────
TRACKER_MAX_DISAPPEARED=150
TRACKER_IOU_MATCH_THRESHOLD=0.2
TRACKER_MAX_CENTROID_DISTANCE=150

# ── Violation logic ───────────────────────────────────────────────────────────
DUPLICATE_COOLDOWN_SECONDS=10
MIN_VIOLATION_FRAMES=15
PPE_MEMORY_WINDOW_SECONDS=3.0

# ── Camera ────────────────────────────────────────────────────────────────────
CAMERA_ID=camera_01

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=5000
API_DEBUG=false
# Render injects $PORT automatically; the app reads it first, then API_PORT.

FLASK_SECRET_KEY=change-me-in-production

# ── Alerts ────────────────────────────────────────────────────────────────────
ENABLE_SOUND_ALERT=false
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# ── Performance ───────────────────────────────────────────────────────────────
TARGET_FPS=20
